rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'josephsalem946@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidMethod(m) {
      return m in ['nowpayments', 'binance', 'meru', 'moncash', 'natcash'];
    }

    function isValidCurrency(c) {
      return c in ['USD', 'HTG', 'EUR'];
    }

    function isValidStatus(s) {
      return s in ['PENDING', 'SUBMITTED', 'PAID_IN', 'COMPLETED', 'UNDERPAID', 'REJECTED', 'EXPIRED'];
    }

    // 3. Entity Validation Blueprints
    function isValidExchangeConfig(data) {
      return data.usdToHtgBuy is number && data.usdToHtgBuy > 0 && data.usdToHtgBuy < 10000 &&
             data.usdToHtgSell is number && data.usdToHtgSell > 0 && data.usdToHtgSell < 10000 &&
             data.eurToUsd is number && data.eurToUsd > 0 && data.eurToUsd < 100 &&
             data.feeNowpayments is number && data.feeNowpayments >= 0 && data.feeNowpayments <= 50 &&
             data.feeBinance is number && data.feeBinance >= 0 && data.feeBinance <= 50 &&
             data.feeMeru is number && data.feeMeru >= 0 && data.feeMeru <= 50 &&
             data.feeMoncash is number && data.feeMoncash >= 0 && data.feeMoncash <= 50 &&
             data.feeNatcash is number && data.feeNatcash >= 0 && data.feeNatcash <= 50 &&
             data.minOrderUsd is number && data.minOrderUsd > 0 && data.minOrderUsd <= 10000 &&
             data.maxOrderUsd is number && data.maxOrderUsd >= data.minOrderUsd && data.maxOrderUsd <= 1000000 &&
             data.moncashMerchant is string && data.moncashMerchant.size() >= 4 && data.moncashMerchant.size() <= 60 &&
             data.natcashMerchant is string && data.natcashMerchant.size() >= 4 && data.natcashMerchant.size() <= 60 &&
             data.binancePayId is string && data.binancePayId.size() >= 2 && data.binancePayId.size() <= 80 &&
             data.meruTag is string && data.meruTag.size() >= 2 && data.meruTag.size() <= 80 &&
             data.backendBaseUrl is string && data.backendBaseUrl.size() <= 300 &&
             data.gatewayMode is string && data.gatewayMode in ['SANDBOX', 'LIVE'] &&
             data.moncashOnlineEnabled is bool &&
             data.natcashOnlineEnabled is bool &&
             data.binanceOnlineEnabled is bool &&
             data.nowpaymentsOnlineEnabled is bool &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 40 &&
             data.isAgeVerified is bool &&
             data.isBlocked is bool &&
             (!('balanceMoncashHtg' in data) || (data.balanceMoncashHtg is number && data.balanceMoncashHtg >= 0 && data.balanceMoncashHtg <= 100000000)) &&
             (!('balanceNatcashHtg' in data) || (data.balanceNatcashHtg is number && data.balanceNatcashHtg >= 0 && data.balanceNatcashHtg <= 100000000)) &&
             (!('balanceBinanceUsd' in data) || (data.balanceBinanceUsd is number && data.balanceBinanceUsd >= 0 && data.balanceBinanceUsd <= 100000000)) &&
             (!('balanceMeruUsd' in data) || (data.balanceMeruUsd is number && data.balanceMeruUsd >= 0 && data.balanceMeruUsd <= 100000000)) &&
             (!('balanceNowpaymentsUsd' in data) || (data.balanceNowpaymentsUsd is number && data.balanceNowpaymentsUsd >= 0 && data.balanceNowpaymentsUsd <= 100000000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function areInitialBalancesZero(data) {
      return (!('balanceMoncashHtg' in data) || data.balanceMoncashHtg == 0) &&
             (!('balanceNatcashHtg' in data) || data.balanceNatcashHtg == 0) &&
             (!('balanceBinanceUsd' in data) || data.balanceBinanceUsd == 0) &&
             (!('balanceMeruUsd' in data) || data.balanceMeruUsd == 0) &&
             (!('balanceNowpaymentsUsd' in data) || data.balanceNowpaymentsUsd == 0);
    }

    function areGatewayBalancesNonIncreasing(inc, ex) {
      return (!('balanceMoncashHtg' in inc) || (inc.balanceMoncashHtg >= 0 && inc.balanceMoncashHtg <= ('balanceMoncashHtg' in ex ? ex.balanceMoncashHtg : 0))) &&
             (!('balanceNatcashHtg' in inc) || (inc.balanceNatcashHtg >= 0 && inc.balanceNatcashHtg <= ('balanceNatcashHtg' in ex ? ex.balanceNatcashHtg : 0))) &&
             (!('balanceBinanceUsd' in inc) || (inc.balanceBinanceUsd >= 0 && inc.balanceBinanceUsd <= ('balanceBinanceUsd' in ex ? ex.balanceBinanceUsd : 0))) &&
             (!('balanceMeruUsd' in inc) || (inc.balanceMeruUsd >= 0 && inc.balanceMeruUsd <= ('balanceMeruUsd' in ex ? ex.balanceMeruUsd : 0))) &&
             (!('balanceNowpaymentsUsd' in inc) || (inc.balanceNowpaymentsUsd >= 0 && inc.balanceNowpaymentsUsd <= ('balanceNowpaymentsUsd' in ex ? ex.balanceNowpaymentsUsd : 0)));
    }

    function walletBalanceForMethod(data, method) {
      return method == 'moncash' ? ('balanceMoncashHtg' in data ? data.balanceMoncashHtg : 0) :
             method == 'natcash' ? ('balanceNatcashHtg' in data ? data.balanceNatcashHtg : 0) :
             method == 'binance' ? ('balanceBinanceUsd' in data ? data.balanceBinanceUsd : 0) :
             method == 'meru' ? ('balanceMeruUsd' in data ? data.balanceMeruUsd : 0) :
             ('balanceNowpaymentsUsd' in data ? data.balanceNowpaymentsUsd : 0);
    }

    function walletDebitVerified(uid, method) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return walletBalanceForMethod(afterUser, method) >= 0 &&
             walletBalanceForMethod(afterUser, method) < walletBalanceForMethod(beforeUser, method);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.orderCode is string && data.orderCode.size() >= 5 && data.orderCode.size() <= 32 &&
             isValidMethod(data.sendMethod) &&
             isValidMethod(data.receiveMethod) &&
             ((('orderType' in data) && data.orderType == 'TOPUP' && data.sendMethod == data.receiveMethod) ||
              (data.sendMethod != data.receiveMethod)) &&
             isValidCurrency(data.sendCurrency) &&
             isValidCurrency(data.receiveCurrency) &&
             data.cryptoCoin is string && data.cryptoCoin.size() <= 32 &&
             data.sendAmount is number && data.sendAmount > 0 && data.sendAmount <= 100000000 &&
             data.receiveAmount is number && data.receiveAmount > 0 && data.receiveAmount <= 100000000 &&
             data.amountUsd is number && data.amountUsd > 0 && data.amountUsd <= 1000000 &&
             data.amountHtg is number && data.amountHtg > 0 && data.amountHtg <= 100000000 &&
             data.amountEur is number && data.amountEur > 0 && data.amountEur <= 1000000 &&
             data.baseRate is number && data.baseRate > 0 &&
             data.feePercent is number && data.feePercent >= 0 && data.feePercent <= 100 &&
             data.effectiveRate is number && data.effectiveRate > 0 &&
             data.destAccount is string && data.destAccount.size() >= 3 && data.destAccount.size() <= 160 &&
             data.paymentInstruction is string && data.paymentInstruction.size() >= 3 && data.paymentInstruction.size() <= 300 &&
             data.payAddress is string && data.payAddress.size() <= 200 &&
             data.payCryptoAmount is number && data.payCryptoAmount >= 0 &&
             data.externalTxRef is string && data.externalTxRef.size() <= 120 &&
             (!('gatewayMode' in data) || (data.gatewayMode is string && data.gatewayMode in ['MANUAL', 'ONLINE', 'SANDBOX', 'WALLET'])) &&
             (!('gatewayOrderId' in data) || (data.gatewayOrderId is string && data.gatewayOrderId.size() <= 160)) &&
             (!('checkoutUrl' in data) || (data.checkoutUrl is string && data.checkoutUrl.size() <= 500)) &&
             (!('gatewayStatus' in data) || (data.gatewayStatus is string && data.gatewayStatus in ['NONE', 'INITIATED', 'WAITING_WEBHOOK', 'CONFIRMED', 'FAILED'])) &&
             (!('orderType' in data) || (data.orderType is string && data.orderType in ['EXCHANGE', 'TOPUP'])) &&
             isValidStatus(data.status) &&
             data.adminNote is string && data.adminNote.size() <= 300 &&
             data.expiresAtMillis is int && data.expiresAtMillis > 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('completedAt' in data) || data.completedAt == null || (data.completedAt is timestamp && data.completedAt <= request.time));
    }

    function isValidPaymentSession(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 &&
             data.orderCode is string && data.orderCode.size() >= 5 && data.orderCode.size() <= 32 &&
             isValidMethod(data.provider) &&
             data.gatewayMode is string && data.gatewayMode in ['SANDBOX', 'LIVE', 'ONLINE'] &&
             data.gatewayOrderId is string && data.gatewayOrderId.size() <= 160 &&
             data.checkoutUrl is string && data.checkoutUrl.size() <= 500 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             isValidCurrency(data.currency) &&
             data.status is string && data.status in ['INITIATED', 'CHECKOUT_OPENED', 'CONFIRMED', 'FAILED', 'EXPIRED'] &&
             data.webhookVerified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLedgerEntry(data) {
      return data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 &&
             data.orderCode is string && data.orderCode.size() >= 5 && data.orderCode.size() <= 32 &&
             data.accountName is string && data.accountName.size() >= 3 && data.accountName.size() <= 64 &&
             data.entryType in ['CREDIT', 'DEBIT'] &&
             isValidCurrency(data.currency) &&
             data.amount is number && data.amount > 0 &&
             data.note is string && data.note.size() >= 1 && data.note.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAdminNotification(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 500 &&
             data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
             data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 160 &&
             data.isAlert is bool &&
             data.sentBy is string && data.sentBy == request.auth.uid &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStoreConfig(data) {
      return data.baseRateHtg is number && data.baseRateHtg > 0 && data.baseRateHtg < 10000 &&
             data.markupPercent is number && data.markupPercent >= 0 && data.markupPercent <= 50 &&
             data.reloadlyBalanceUsd is number && data.reloadlyBalanceUsd >= 0 && data.reloadlyBalanceUsd <= 1000000 &&
             data.meruBalanceUsd is number && data.meruBalanceUsd >= 0 && data.meruBalanceUsd <= 1000000 &&
             data.reloadlyActive is bool &&
             data.ezpinActive is bool &&
             data.moncashActive is bool &&
             data.natcashActive is bool &&
             data.binanceActive is bool &&
             data.nowpaymentsActive is bool &&
             data.reloadlyLatencyMs is int && data.reloadlyLatencyMs >= 0 && data.reloadlyLatencyMs <= 60000 &&
             data.ezpinLatencyMs is int && data.ezpinLatencyMs >= 0 && data.ezpinLatencyMs <= 60000 &&
             data.availableNetflixCount is int && data.availableNetflixCount >= 0 && data.availableNetflixCount <= 10000 &&
             data.pendingStarlinkCount is int && data.pendingStarlinkCount >= 0 && data.pendingStarlinkCount <= 10000 &&
             (!('fulfillmentMode' in data) || (data.fulfillmentMode is string && data.fulfillmentMode in ['AUTO', 'MANUAL'])) &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStoreProduct(data) {
      return data.category is string && data.category in ['gaming', 'streaming', 'telecom', 'cards', 'ai_pro', 'web_travel'] &&
             data.deliveryType is string && data.deliveryType in ['topup', 'pin', 'netflix_profile', 'starlink'] &&
             data.badge is string && data.badge.size() >= 2 && data.badge.size() <= 48 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
             data.subtitle is string && data.subtitle.size() <= 240 &&
             data.usdCost is number && data.usdCost > 0 && data.usdCost <= 10000 &&
             data.usdSell is number && data.usdSell >= data.usdCost && data.usdSell <= 10000 &&
             data.requiresTargetAccount is bool &&
             data.targetAccountLabel is string && data.targetAccountLabel.size() <= 120 &&
             data.targetAccountHint is string && data.targetAccountHint.size() <= 160 &&
             data.selectLabel is string && data.selectLabel.size() <= 120 &&
             data.selectOptions is list && data.selectOptions.size() <= 20 &&
             data.stock is int && data.stock >= 0 && data.stock <= 100000 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNetflixInventoryItem(data) {
      return data.accountEmail is string && data.accountEmail.size() >= 3 && data.accountEmail.size() <= 200 &&
             data.accountPassword is string && data.accountPassword.size() >= 1 && data.accountPassword.size() <= 120 &&
             data.profileName is string && data.profileName.size() >= 1 && data.profileName.size() <= 60 &&
             data.profilePin is string && data.profilePin.size() >= 4 && data.profilePin.size() <= 12 &&
             data.status is string && data.status in ['AVAILABLE', 'OCCUPIED'] &&
             data.assignedOrderId is string && data.assignedOrderId.size() <= 128 &&
             data.assignedUserId is string && data.assignedUserId.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStoreOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.orderCode is string && data.orderCode.size() >= 5 && data.orderCode.size() <= 32 &&
             data.productId is string && data.productId.size() >= 2 && data.productId.size() <= 64 &&
             data.productTitle is string && data.productTitle.size() >= 2 && data.productTitle.size() <= 160 &&
             data.category is string && data.category in ['gaming', 'netflix', 'starlink', 'streaming', 'telecom', 'cards', 'ai_pro', 'web_travel'] &&
             data.deliveryType is string && data.deliveryType in ['topup', 'pin', 'netflix_profile', 'starlink'] &&
             data.usdCost is number && data.usdCost > 0 && data.usdCost <= 10000 &&
             data.usdSell is number && data.usdSell > 0 && data.usdSell <= 10000 &&
             data.amountHtg is number && data.amountHtg > 0 && data.amountHtg <= 10000000 &&
             data.effectiveRate is number && data.effectiveRate > 0 && data.effectiveRate < 20000 &&
             data.gateway is string && data.gateway in ['moncash', 'natcash', 'binance', 'nowpayments'] &&
             data.targetAccount is string && data.targetAccount.size() <= 160 &&
             data.externalTxRef is string && data.externalTxRef.size() <= 120 &&
             data.gatewayOrderId is string && data.gatewayOrderId.size() <= 160 &&
             data.checkoutUrl is string && data.checkoutUrl.size() <= 500 &&
             data.gatewayStatus is string && data.gatewayStatus in ['NONE', 'INITIATED', 'WAITING_WEBHOOK', 'CONFIRMED', 'FAILED', 'WALLET_DEBITED'] &&
             data.status is string && data.status in ['PENDING', 'SUBMITTED', 'PAID', 'DELIVERED', 'REJECTED', 'EXPIRED'] &&
             data.deliverable is string && data.deliverable.size() <= 500 &&
             data.adminNote is string && data.adminNote.size() <= 300 &&
             (!('logs' in data) || (data.logs is list && data.logs.size() <= 30)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidInvestment(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.investCode is string && data.investCode.size() >= 5 && data.investCode.size() <= 32 &&
             data.categoryKey is string && data.categoryKey in ['sans_risque', 'moins_risque', 'a_risque'] &&
             data.categoryName is string && data.categoryName.size() >= 3 && data.categoryName.size() <= 80 &&
             data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 120 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             data.currency is string && data.currency in ['GDS', 'USD'] &&
             data.durationLabel is string && data.durationLabel.size() >= 2 && data.durationLabel.size() <= 32 &&
             data.months is int && data.months in [1, 3, 6, 12] &&
             data.monthlyProfit is number && data.monthlyProfit > 0 && data.monthlyProfit <= 100000000 &&
             data.totalProfit is number && data.totalProfit > 0 && data.totalProfit <= 100000000 &&
             data.gatewayId is string && data.gatewayId in ['moncash', 'natcash', 'binance', 'nowpayments'] &&
             data.gatewayName is string && data.gatewayName.size() >= 2 && data.gatewayName.size() <= 64 &&
             data.feeAmount is number && data.feeAmount >= 0 && data.feeAmount <= 10000000 &&
             data.totalPaid is number && data.totalPaid >= data.amount && data.totalPaid <= 110000000 &&
             data.endDateLabel is string && data.endDateLabel.size() >= 3 && data.endDateLabel.size() <= 40 &&
             data.status is string && data.status in ['PENDING', 'ACTIVE', 'REJECTED'] &&
             data.adminNote is string && data.adminNote.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Collection Rules
    match /exchange_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               isAdmin() &&
                               isValidId(configId) &&
                               incoming().keys().hasAll([
                                 'usdToHtgBuy', 'usdToHtgSell', 'eurToUsd',
                                 'feeNowpayments', 'feeBinance', 'feeMeru', 'feeMoncash', 'feeNatcash',
                                 'minOrderUsd', 'maxOrderUsd',
                                 'moncashMerchant', 'natcashMerchant', 'binancePayId', 'meruTag',
                                 'backendBaseUrl', 'gatewayMode',
                                 'moncashOnlineEnabled', 'natcashOnlineEnabled', 'binanceOnlineEnabled', 'nowpaymentsOnlineEnabled',
                                 'updatedAt', 'updatedBy'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'usdToHtgBuy', 'usdToHtgSell', 'eurToUsd',
                                 'feeNowpayments', 'feeBinance', 'feeMeru', 'feeMoncash', 'feeNatcash',
                                 'minOrderUsd', 'maxOrderUsd',
                                 'moncashMerchant', 'natcashMerchant', 'binancePayId', 'meruTag',
                                 'backendBaseUrl', 'gatewayMode',
                                 'moncashOnlineEnabled', 'natcashOnlineEnabled', 'binanceOnlineEnabled', 'nowpaymentsOnlineEnabled',
                                 'updatedAt', 'updatedBy'
                               ]) &&
                               incoming().updatedBy == request.auth.uid &&
                               isValidExchangeConfig(incoming());
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().isBlocked == false &&
                       areInitialBalancesZero(incoming()) &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'phoneNumber', 'isAgeVerified', 'isBlocked', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'displayName', 'phoneNumber', 'isAgeVerified', 'isBlocked',
                         'balanceMoncashHtg', 'balanceNatcashHtg', 'balanceBinanceUsd', 'balanceMeruUsd', 'balanceNowpaymentsUsd',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           request.auth.uid == userId &&
                           incoming().isBlocked == existing().isBlocked &&
                           areGatewayBalancesNonIncreasing(incoming(), existing()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'phoneNumber', 'isAgeVerified',
                             'balanceMoncashHtg', 'balanceNatcashHtg', 'balanceBinanceUsd', 'balanceMeruUsd', 'balanceNowpaymentsUsd',
                             'updatedAt'
                           ])
                         )
                       );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().externalTxRef == '' &&
                       incoming().adminNote == '' &&
                       (!('gatewayStatus' in incoming()) || incoming().gatewayStatus in ['NONE', 'INITIATED']) &&
                       (!('completedAt' in incoming()) || incoming().completedAt == null) &&
                       (
                         !('gatewayMode' in incoming()) ||
                         incoming().gatewayMode != 'WALLET' ||
                         (
                           (!('orderType' in incoming()) || incoming().orderType == 'EXCHANGE') &&
                           walletDebitVerified(request.auth.uid, incoming().sendMethod)
                         )
                       ) &&
                       incoming().keys().hasAll([
                         'userId', 'userEmail', 'orderCode',
                         'sendMethod', 'receiveMethod', 'sendCurrency', 'receiveCurrency', 'cryptoCoin',
                         'sendAmount', 'receiveAmount', 'amountUsd', 'amountHtg', 'amountEur',
                         'baseRate', 'feePercent', 'effectiveRate', 'destAccount', 'paymentInstruction',
                         'payAddress', 'payCryptoAmount', 'externalTxRef', 'status', 'adminNote',
                         'expiresAtMillis', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userEmail', 'orderCode',
                         'sendMethod', 'receiveMethod', 'sendCurrency', 'receiveCurrency', 'cryptoCoin',
                         'sendAmount', 'receiveAmount', 'amountUsd', 'amountHtg', 'amountEur',
                         'baseRate', 'feePercent', 'effectiveRate', 'destAccount', 'paymentInstruction',
                         'payAddress', 'payCryptoAmount', 'externalTxRef',
                         'gatewayMode', 'gatewayOrderId', 'checkoutUrl', 'gatewayStatus', 'orderType',
                         'status', 'adminNote', 'expiresAtMillis', 'createdAt', 'updatedAt', 'completedAt'
                       ]) &&
                       (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false);
      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().orderCode == existing().orderCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'SUBMITTED' &&
                           incoming().externalTxRef.size() >= 4 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['externalTxRef', 'status', 'updatedAt'])
                         ) ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'PENDING' &&
                           (!('gatewayStatus' in incoming()) || incoming().gatewayStatus in ['NONE', 'INITIATED', 'WAITING_WEBHOOK']) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'gatewayMode', 'gatewayOrderId', 'checkoutUrl', 'gatewayStatus',
                             'payAddress', 'payCryptoAmount', 'updatedAt'
                           ])
                         ) ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'EXPIRED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() ||
                       (isSignedIn() && existing().userId == request.auth.uid && existing().status in ['PENDING', 'EXPIRED'] && (!('gatewayMode' in existing()) || existing().gatewayMode != 'WALLET'));
    }

    match /payment_sessions/{sessionId} {
      allow get, list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(sessionId) &&
                       isValidPaymentSession(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status in ['INITIATED', 'CHECKOUT_OPENED'] &&
                       incoming().webhookVerified == false &&
                       incoming().keys().hasAll([
                         'userId', 'orderId', 'orderCode', 'provider', 'gatewayMode',
                         'gatewayOrderId', 'checkoutUrl', 'amount', 'currency',
                         'status', 'webhookVerified', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'orderId', 'orderCode', 'provider', 'gatewayMode',
                         'gatewayOrderId', 'checkoutUrl', 'amount', 'currency',
                         'status', 'webhookVerified', 'createdAt', 'updatedAt'
                       ]) &&
                       (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false);
      allow update: if isSignedIn() &&
                       isValidId(sessionId) &&
                       isValidPaymentSession(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().orderId == existing().orderId &&
                       incoming().provider == existing().provider &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().webhookVerified == false &&
                           incoming().webhookVerified == false &&
                           incoming().status in ['INITIATED', 'CHECKOUT_OPENED'] &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkoutUrl', 'gatewayOrderId', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin();
    }

    match /webhook_events/{eventId} {
      allow get, list: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /tx_refs/{txRefId} {
      allow get: if isSignedIn() && isValidId(txRefId);
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(txRefId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().orderId is string && incoming().orderId.size() >= 1 && incoming().orderId.size() <= 128 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().keys().hasAll(['userId', 'orderId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'orderId', 'createdAt']);
      allow update, delete: if false;
    }

    match /ledger_entries/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(entryId) &&
                       incoming().keys().hasAll(['orderId', 'orderCode', 'accountName', 'entryType', 'currency', 'amount', 'note', 'createdAt']) &&
                       incoming().keys().hasOnly(['orderId', 'orderCode', 'accountName', 'entryType', 'currency', 'amount', 'note', 'createdAt']) &&
                       isValidLedgerEntry(incoming());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    match /admin_notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        existing().targetUserId == 'ALL' ||
        existing().targetUserId == request.auth.uid
      );
      allow create: if isAdmin() &&
                       isValidId(notificationId) &&
                       incoming().keys().hasAll(['title', 'message', 'targetUserId', 'targetLabel', 'isAlert', 'sentBy', 'createdAt']) &&
                       incoming().keys().hasOnly(['title', 'message', 'targetUserId', 'targetLabel', 'isAlert', 'sentBy', 'createdAt']) &&
                       isValidAdminNotification(incoming());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /store_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               isAdmin() &&
                               isValidId(configId) &&
                               incoming().keys().hasAll([
                                 'baseRateHtg', 'markupPercent', 'reloadlyBalanceUsd', 'meruBalanceUsd',
                                 'reloadlyActive', 'ezpinActive', 'moncashActive', 'natcashActive',
                                 'binanceActive', 'nowpaymentsActive', 'reloadlyLatencyMs', 'ezpinLatencyMs',
                                 'availableNetflixCount', 'pendingStarlinkCount', 'updatedBy', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'baseRateHtg', 'markupPercent', 'reloadlyBalanceUsd', 'meruBalanceUsd',
                                 'reloadlyActive', 'ezpinActive', 'moncashActive', 'natcashActive',
                                 'binanceActive', 'nowpaymentsActive', 'reloadlyLatencyMs', 'ezpinLatencyMs',
                                 'availableNetflixCount', 'pendingStarlinkCount', 'fulfillmentMode', 'updatedBy', 'updatedAt'
                               ]) &&
                               incoming().updatedBy == request.auth.uid &&
                               isValidStoreConfig(incoming());
      allow delete: if false;
    }

    match /store_products/{productId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(productId) &&
                       incoming().keys().hasAll([
                         'category', 'deliveryType', 'badge', 'title', 'subtitle',
                         'usdCost', 'usdSell', 'requiresTargetAccount', 'targetAccountLabel',
                         'targetAccountHint', 'selectLabel', 'selectOptions', 'stock',
                         'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'category', 'deliveryType', 'badge', 'title', 'subtitle',
                         'usdCost', 'usdSell', 'requiresTargetAccount', 'targetAccountLabel',
                         'targetAccountHint', 'selectLabel', 'selectOptions', 'stock',
                         'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdBy == request.auth.uid &&
                       isValidStoreProduct(incoming());
      allow update: if isAdmin() &&
                       isValidId(productId) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       isValidStoreProduct(incoming());
      allow delete: if isAdmin();
    }

    match /store_netflix_inventory/{itemId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(itemId) &&
                       incoming().keys().hasAll([
                         'accountEmail', 'accountPassword', 'profileName', 'profilePin',
                         'status', 'assignedOrderId', 'assignedUserId', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'accountEmail', 'accountPassword', 'profileName', 'profilePin',
                         'status', 'assignedOrderId', 'assignedUserId', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidNetflixInventoryItem(incoming());
      allow update: if isAdmin() &&
                       isValidId(itemId) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidNetflixInventoryItem(incoming());
      allow delete: if isAdmin();
    }

    match /store_orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidStoreOrder(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().deliverable == '' &&
                       incoming().externalTxRef == '' &&
                       incoming().adminNote == '' &&
                       incoming().gatewayStatus in ['NONE', 'INITIATED', 'WALLET_DEBITED'] &&
                       (incoming().gatewayStatus != 'WALLET_DEBITED' || walletDebitVerified(request.auth.uid, incoming().gateway)) &&
                       incoming().keys().hasAll([
                         'userId', 'userEmail', 'orderCode', 'productId', 'productTitle',
                         'category', 'deliveryType', 'usdCost', 'usdSell', 'amountHtg', 'effectiveRate',
                         'gateway', 'targetAccount', 'externalTxRef', 'gatewayOrderId', 'checkoutUrl',
                         'gatewayStatus', 'status', 'deliverable', 'adminNote', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userEmail', 'orderCode', 'productId', 'productTitle',
                         'category', 'deliveryType', 'usdCost', 'usdSell', 'amountHtg', 'effectiveRate',
                         'gateway', 'targetAccount', 'externalTxRef', 'gatewayOrderId', 'checkoutUrl',
                         'gatewayStatus', 'status', 'deliverable', 'adminNote', 'logs', 'createdAt', 'updatedAt'
                       ]) &&
                       (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false);
      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidStoreOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().orderCode == existing().orderCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'SUBMITTED' &&
                           incoming().externalTxRef.size() >= 4 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['externalTxRef', 'status', 'updatedAt'])
                         ) ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status == 'PENDING' &&
                           incoming().status == 'PENDING' &&
                           incoming().gatewayStatus in ['NONE', 'INITIATED', 'WAITING_WEBHOOK'] &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['gatewayOrderId', 'checkoutUrl', 'gatewayStatus', 'updatedAt'])
                         )
                       );
      allow delete: if isAdmin() ||
                       (isSignedIn() && existing().userId == request.auth.uid && existing().status in ['PENDING', 'EXPIRED'] && existing().gatewayStatus != 'WALLET_DEBITED');
    }

    match /investments/{investId} {
      allow get: if isSignedIn() && isValidId(investId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(investId) &&
                       isValidInvestment(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().adminNote == '' &&
                       walletDebitVerified(request.auth.uid, incoming().gatewayId) &&
                       incoming().keys().hasAll([
                         'userId', 'userEmail', 'investCode', 'categoryKey', 'categoryName', 'sector',
                         'amount', 'currency', 'durationLabel', 'months', 'monthlyProfit', 'totalProfit',
                         'gatewayId', 'gatewayName', 'feeAmount', 'totalPaid', 'endDateLabel',
                         'status', 'adminNote', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userEmail', 'investCode', 'categoryKey', 'categoryName', 'sector',
                         'amount', 'currency', 'durationLabel', 'months', 'monthlyProfit', 'totalProfit',
                         'gatewayId', 'gatewayName', 'feeAmount', 'totalPaid', 'endDateLabel',
                         'status', 'adminNote', 'createdAt', 'updatedAt'
                       ]) &&
                       (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false);
      allow update: if isAdmin() &&
                       isValidId(investId) &&
                       isValidInvestment(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().investCode == existing().investCode &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() ||
                       (isSignedIn() && existing().userId == request.auth.uid && existing().status == 'REJECTED');
    }
  }
}
